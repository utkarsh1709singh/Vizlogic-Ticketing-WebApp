# 1️⃣ Use Node.js as the base image
FROM node:18

# 2️⃣ Set the working directory inside the container
WORKDIR /app

# 3️⃣ Copy package.json and package-lock.json to the container
COPY package.json package-lock.json ./

# 4️⃣ Install dependencies
RUN npm install

# 5️⃣ Copy the entire project to the container
COPY . .

# 6️⃣ Expose the application's port (3000)
EXPOSE 3000

# 7️⃣ Start the application
CMD ["node", "index.js"]
